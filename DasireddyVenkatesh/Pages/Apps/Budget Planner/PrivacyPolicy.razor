@page "/apps/budget-planner/privacy-policy"

<PageTitle>Privacy Policy - Budget Planner</PageTitle>

<div class="policy-page">
    <div class="policy-container">

        <div class="policy-topbar">
            <div class="policy-brand">
                <div class="policy-brand-icon">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" />
                </div>

                <MudText Class="policy-brand-title" Typo="Typo.h6">
                    Budget Planner
                </MudText>
            </div>

            <MudButton
                Class="policy-privacy-link"
                Variant="Variant.Outlined"
                Size="Size.Small"
                StartIcon="@Icons.Material.Filled.Security">
                Privacy
            </MudButton>
        </div>

        <MudPaper Class="privacy-hero" Elevation="0">
            <div class="privacy-hero-content">

                <div class="privacy-shield">
                    <MudIcon
                        Icon="@Icons.Material.Filled.Shield"
                        Size="Size.Large" />
                </div>

                <MudText Class="privacy-eyebrow">
                    Budget Planner Privacy Center
                </MudText>

                <MudText Class="privacy-title">
                    Privacy &amp; Security
                </MudText>

                <MudText Class="privacy-subtitle">
                    Your financial information stays under your control.
                </MudText>

                <MudChipSet T="string" Class="privacy-badges">

                    <MudChip
                        Class="privacy-chip"
                        Variant="Variant.Outlined"
                        Icon="@Icons.Material.Filled.Storage">
                        Local-first
                    </MudChip>

                    <MudChip
                        Class="privacy-chip"
                        Variant="Variant.Outlined"
                        Icon="@Icons.Material.Filled.Dns">
                        Private storage
                    </MudChip>

                    <MudChip
                        Class="privacy-chip-blue"
                        Variant="Variant.Outlined"
                        Icon="@Icons.Material.Filled.PersonOff">
                        No account
                    </MudChip>

                    <MudChip
                        Class="privacy-chip-dark"
                        Variant="Variant.Outlined"
                        Icon="@Icons.Material.Filled.CalendarToday">
                        September 25, 2026
                    </MudChip>

                </MudChipSet>
            </div>
        </MudPaper>

        <MudGrid Class="policy-stat-row" Spacing="2">

            <MudItem xs="12" md="4">
                <MudPaper
                    Class="privacy-stat privacy-stat-device"
                    Elevation="0">

                    <div class="privacy-stat-content">

                        <div class="privacy-stat-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Storage" />
                        </div>

                        <div>
                            <MudText Class="privacy-stat-label">
                                Data location
                            </MudText>

                            <MudText Class="privacy-stat-value">
                                Your device
                            </MudText>
                        </div>

                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper
                    Class="privacy-stat privacy-stat-control"
                    Elevation="0">

                    <div class="privacy-stat-content">

                        <div class="privacy-stat-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Tune" />
                        </div>

                        <div>
                            <MudText Class="privacy-stat-label">
                                User control
                            </MudText>

                            <MudText Class="privacy-stat-value">
                                You decide
                            </MudText>
                        </div>

                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper
                    Class="privacy-stat privacy-stat-security"
                    Elevation="0">

                    <div class="privacy-stat-content">

                        <div class="privacy-stat-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Security" />
                        </div>

                        <div>
                            <MudText Class="privacy-stat-label">
                                Security
                            </MudText>

                            <MudText Class="privacy-stat-value">
                                Android protected
                            </MudText>
                        </div>

                    </div>
                </MudPaper>
            </MudItem>

        </MudGrid>

        <div class="policy-overview-section">

            <MudPaper
                Class="privacy-overview"
                Elevation="0">

                <MudText
                    Class="privacy-overview-title"
                    Typo="Typo.h5">

                    <MudIcon Icon="@Icons.Material.Filled.PrivacyTip" />

                    Your privacy at a glance
                </MudText>

                <MudText
                    Class="privacy-overview-text"
                    Typo="Typo.body1">

                    Budget Planner is a personal budgeting and expense tracking
                    application created by Dasireddy Venkatesh. It is designed
                    as a local-first application.
                </MudText>

                <MudText
                    Class="privacy-overview-text"
                    Typo="Typo.body1">

                    Your budgeting information, expense records, categories,
                    and preferences are stored locally on your Android device.
                </MudText>

                <MudAlert
                    Class="privacy-notice"
                    Severity="Severity.Success"
                    Variant="Variant.Filled"
                    Icon="@Icons.Material.Filled.CheckCircle">

                    <strong>
                        Your information remains on your device unless you
                        explicitly choose a feature that transfers or shares it.
                    </strong>

                </MudAlert>

            </MudPaper>

        </div>

        <div class="policy-document-section">

            <MudPaper
                Class="privacy-policy"
                Elevation="0">

                <div class="privacy-policy-header">

                    <MudText
                        Class="privacy-policy-title"
                        Typo="Typo.h5">

                        <MudIcon Icon="@Icons.Material.Filled.Description" />

                        Privacy Policy
                    </MudText>

                    <MudText Class="policy-section-subtitle">
                        Effective date: September 25, 2026
                    </MudText>

                </div>

                <MudExpansionPanels
                    Class="privacy-panels"
                    MultiExpansion="true"
                    Gutters="false"
                    Elevation="0">

                    <MudExpansionPanel Expanded="true">

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Info" />
                                <span>1. Introduction</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    Budget Planner is a personal budgeting and
                                    expense tracking application created by
                                    Dasireddy Venkatesh.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    The application is designed as a
                                    local-first application. Your budgeting
                                    information, expense records, categories,
                                    and preferences are stored locally on your
                                    Android device.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    This Privacy Policy explains what
                                    information the application handles, how
                                    that information is used, where it is
                                    stored, and when it may leave your device.
                                </MudText>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                                <span>2. Information We Collect</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    Budget Planner does not require you to
                                    create an account to use its core
                                    functionality.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    You are not required to provide your name,
                                    email address, or phone number to use the
                                    budgeting features.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    Information you may enter into the
                                    application includes:
                                </MudText>

                                <MudList T="string" Class="privacy-list">

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Payments">
                                        Expense amounts
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Category">
                                        Expense categories
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.CalendarMonth">
                                        Transaction dates
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Notes">
                                        Notes or comments
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.AccountBalanceWallet">
                                        Monthly budget information
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.CreateNewFolder">
                                        Custom categories and preferences
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Settings">
                                        Theme and application settings
                                    </MudListItem>

                                </MudList>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Storage" />
                                <span>3. How Your Data Is Stored</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudAlert
                                    Severity="Severity.Info"
                                    Variant="Variant.Outlined"
                                    Icon="@Icons.Material.Filled.Storage">

                                    Your application data is stored locally
                                    within the app's private storage on your
                                    Android device.
                                </MudAlert>

                                <MudText Typo="Typo.body1">
                                    Budget Planner uses local storage,
                                    including a local SQLite database, to
                                    maintain your budgeting information.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    The application does not automatically
                                    upload your budgeting data to a remote
                                    developer server.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    Your information remains on your device
                                    unless you explicitly use a feature that
                                    transfers, exports, backs up, restores, or
                                    shares the information.
                                </MudText>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Functions" />
                                <span>4. How Your Information Is Used</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    Information entered into Budget Planner is
                                    used to provide the application's
                                    budgeting and expense tracking features.
                                </MudText>

                                <MudList T="string" Class="privacy-list">

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.ReceiptLong">
                                        Record and organize transactions
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Calculate">
                                        Calculate spending totals
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.AccountBalanceWallet">
                                        Track budget health
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.TrendingUp">
                                        Show spending trends and forecasts
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.PieChart">
                                        Display category spending
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Backup">
                                        Support backup and restore features
                                    </MudListItem>

                                </MudList>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Share" />
                                <span>5. Sharing and Disclosure</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudAlert
                                    Severity="Severity.Success"
                                    Variant="Variant.Outlined"
                                    Icon="@Icons.Material.Filled.Block">

                                    Budget Planner does not sell or rent your
                                    personal budgeting information.
                                </MudAlert>

                                <MudText Typo="Typo.body1">
                                    Your information is not automatically
                                    shared with advertisers or other third
                                    parties.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    Budget Planner does not use your budgeting
                                    information for personalized advertising.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    Data may leave your device when you
                                    explicitly choose to export, back up,
                                    restore, or share information.
                                </MudText>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Backup" />
                                <span>6. Backups and Exports</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    Backup and export features may contain
                                    information stored by Budget Planner.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    Depending on the feature used, a backup or
                                    export may contain:
                                </MudText>

                                <MudList T="string" Class="privacy-list">

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.ReceiptLong">
                                        Transactions
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Category">
                                        Categories
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Palette">
                                        Category order, icons, and colors
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.AccountBalanceWallet">
                                        Budget information
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Settings">
                                        Application preferences
                                    </MudListItem>

                                </MudList>

                                <MudAlert
                                    Severity="Severity.Warning"
                                    Variant="Variant.Outlined"
                                    Icon="@Icons.Material.Filled.Warning">

                                    You control where exported or backed-up
                                    information is stored and with whom it is
                                    shared.
                                </MudAlert>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Security" />
                                <span>7. Security</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <div class="privacy-security-callout">

                                    <MudStack Row="true" Spacing="2">

                                        <MudIcon
                                            Icon="@Icons.Material.Filled.Security"
                                            Size="Size.Large" />

                                        <div>
                                            <MudText
                                                Class="privacy-lifecycle-title"
                                                Typo="Typo.subtitle1">
                                                Android private storage
                                            </MudText>

                                            <MudText
                                                Class="privacy-lifecycle-text">
                                                Application data is stored
                                                within the app's private
                                                storage environment.
                                            </MudText>
                                        </div>

                                    </MudStack>

                                </div>

                                <MudText Typo="Typo.body1">
                                    Budget Planner relies on Android platform
                                    security and private application storage
                                    for locally stored information.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    Biometric authentication may be supported
                                    when enabled by you and supported by your
                                    device.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    The application does not store biometric
                                    templates, biometric credentials, or
                                    authentication secrets.
                                </MudText>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" />
                                <span>8. Data Retention and Deletion</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    Your locally stored information remains on
                                    your device until you remove it.
                                </MudText>

                                <MudList T="string" Class="privacy-list">

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Delete">
                                        Delete individual transactions from
                                        the application
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.SettingsApplications">
                                        Remove application data through
                                        Android application settings
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.DeleteForever">
                                        Uninstall the application
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Share">
                                        Manage independently stored exports
                                        or backups
                                    </MudListItem>

                                </MudList>

                                <MudText Typo="Typo.body1">
                                    Copies that you have independently exported,
                                    backed up, or shared are controlled by
                                    where you chose to store or share them.
                                </MudText>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.ChildCare" />
                                <span>9. Children's Privacy</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    Budget Planner is not designed to knowingly
                                    collect personal information from children
                                    through an online account or remote
                                    collection system.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    The application does not require an account
                                    or submission of personal contact
                                    information for its core functionality.
                                </MudText>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Extension" />
                                <span>10. Third-Party Services</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    Budget Planner may use Android system
                                    services to provide specific application
                                    functionality.
                                </MudText>

                                <MudList T="string" Class="privacy-list">

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Fingerprint">
                                        Android biometric authentication
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.FolderOpen">
                                        Android file selection
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Backup">
                                        Android backup functionality
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Share">
                                        Android sharing functionality
                                    </MudListItem>

                                </MudList>

                                <MudText Typo="Typo.body1">
                                    These system services operate according to
                                    the applicable Android platform behavior
                                    and permissions.
                                </MudText>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                                <span>11. Permissions</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    Budget Planner requests permissions only
                                    when required for a supported application
                                    feature.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    Permissions may be associated with
                                    features such as file selection, backup,
                                    sharing, or biometric authentication.
                                </MudText>

                                <MudAlert
                                    Severity="Severity.Info"
                                    Variant="Variant.Outlined"
                                    Icon="@Icons.Material.Filled.Tune">

                                    You remain in control of Android
                                    permissions through your device settings.
                                </MudAlert>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.Update" />
                                <span>12. Changes to This Privacy Policy</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    This Privacy Policy may be updated from time
                                    to time to reflect changes to the
                                    application, its features, or its data
                                    handling practices.
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    When the policy is updated, the revised
                                    effective date will be displayed on this
                                    page.
                                </MudText>

                                <MudAlert
                                    Severity="Severity.Info"
                                    Variant="Variant.Outlined"
                                    Icon="@Icons.Material.Filled.CalendarToday">

                                    Current effective date:
                                    <strong>September 25, 2026</strong>
                                </MudAlert>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                    <MudExpansionPanel>

                        <TitleContent>
                            <div class="policy-section-heading">
                                <MudIcon Icon="@Icons.Material.Filled.ContactMail" />
                                <span>13. Contact</span>
                            </div>
                        </TitleContent>

                        <ChildContent>
                            <div class="privacy-panel-content">

                                <MudText Typo="Typo.body1">
                                    If you have questions about this Privacy
                                    Policy or the privacy practices of Budget
                                    Planner, you can contact the developer.
                                </MudText>

                                <MudList T="string" Class="privacy-list">

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Person">
                                        <MudText>
                                            Developer: Dasireddy Venkatesh
                                        </MudText>
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Apps">
                                        <MudText>
                                            Application: Budget Planner
                                        </MudText>
                                    </MudListItem>

                                    <MudListItem
                                        Icon="@Icons.Material.Filled.Email">
                                        <MudLink
                                            Class="privacy-link"
                                            Href="mailto:dasireddyvenkatesh@gmail.com">
                                            dasireddyvenkatesh@gmail.com
                                        </MudLink>
                                    </MudListItem>

                                </MudList>

                            </div>
                        </ChildContent>

                    </MudExpansionPanel>

                </MudExpansionPanels>

            </MudPaper>

        </div>

        <div class="privacy-footer">

            <MudDivider Class="privacy-footer-divider" />

            <MudText Typo="Typo.caption">
                © 2026 Dasireddy Venkatesh · Budget Planner
            </MudText>

            <MudText Typo="Typo.caption">
                Privacy Policy · Effective September 25, 2026
            </MudText>

        </div>

    </div>
</div>